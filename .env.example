DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 持久化 (SQLite: 会话/消息/知识库文档元数据)
# 留空 = 纯内存模式 (重启丢失)
DB_PATH=data/assistant.db

# 知识库向量库 (Chroma)
# 留空 = 纯内存模式 (重启丢失)
CHROMA_PATH=data/chroma

# Embedding 模式: hash (离线, 零 API key, 默认) / local (sentence-transformers) / api (OpenAI 兼容)
EMBEDDING_MODE=hash
EMBEDDING_DIMENSIONS=512
# api 模式可选预设: zhipu / siliconflow / openai / dashscope
# EMBEDDING_PROVIDER=zhipu
# EMBEDDING_API_KEY=
